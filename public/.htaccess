RewriteEngine On

# Let existing files and folders be served normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^api/shorten$ index.php?route=api [QSA,L]
RewriteRule ^([A-Za-z0-9]{6,8})$ index.php?route=redirect&code=$1 [QSA,L]
RewriteRule ^$ index.php [L]
